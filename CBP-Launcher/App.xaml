<Application x:Class="CBPLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CBPLauncher"
             xmlns:logic="clr-namespace:CBPLauncher.Logic"
             xmlns:skins="clr-namespace:CBPLauncher.Skins"
             xmlns:core="clr-namespace:CBPLauncher.Core"
             Startup="App_Startup"
             StartupUri="MainWindow.xaml">

    <!--     xmlns:v="clr-namespace:CBPLauncher.MVVM.View"
             xmlns:vm="clr-namespace:CBPLauncher.MVVM.ViewModel"
             xmlns:wrappers="clr-namespace:CBPLauncher.Wrappers"-->
    <Application.Resources>
        <ResourceDictionary>

            <!--<vm:ViewModel_Primary x:Key="vmPrimary"/>-->

            <!--<wrappers:BindingWrapper x:Key="BindingWrapper"/>-->

            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design Themes aka MaterialDesignInXaml https://www.nuget.org/packages/MaterialDesignThemes/ -->
                <!--<materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />-->
                
                <!-- CBP Launcher's custom XAML controls -->
                <ResourceDictionary Source="Theme/BBRadioButton.xaml"/>
                <!--<ResourceDictionary Source="Theme/BBScrollbar.xaml"/>-->
                <ResourceDictionary Source="Theme/LauncherPrimaryButton.xaml"/>
                <ResourceDictionary Source="Theme/ImageButtonHoverFix.xaml"/>
                <ResourceDictionary Source="Theme/RoNCheckbox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <logic:MainCode x:Key="MainCodeInstance"/>
            <!--<core-->

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Dummy tab, used by both skins to force-update a tab by switching to it then instantly switching back -->
            <DataTemplate DataType="{x:Type logic:DummyTabVM}">
                <skins:DummyTab/>
            </DataTemplate>
            
            <!-- Spartan V1 skin-->
            <!-- NOTE: after moving to delayed load of some stuff, the XAML Designer threw a hissy fit and I didn't bother fixing all of its design-time complaints -->
            <DataTemplate DataType="{x:Type logic:SpartanV1VM}">
                <skins:SpartanV1/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1MiniVM}">
                <skins:SpartanV1Mini/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1AnnouncementsVM}">
                <skins:SpartanV1Announcements/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1OldAnnouncementsVM}">
                <skins:SpartanV1OldAnnouncements/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1PatchNotesVM}">
                <skins:SpartanV1PatchNotes/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1ModManagerVM}">
                <skins:SpartanV1ModManager/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1OptionsVM}">
                <skins:SpartanV1Options/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1LogVM}">
                <skins:SpartanV1Log/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:SpartanV1OtherVM}">
                <skins:SpartanV1Other/>
            </DataTemplate>

            <!-- Classic Plus skin -->
            <DataTemplate DataType="{x:Type logic:ClassicPlusVM}">
                <skins:ClassicPlus/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusMiniVM}">
                <skins:ClassicPlusMini/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusAnnouncementsVM}">
                <skins:ClassicPlusAnnouncements/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusOldAnnouncementsVM}">
                <skins:ClassicPlusOldAnnouncements/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusPatchNotesVM}">
                <skins:ClassicPlusPatchNotes/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusModManagerVM}">
                <skins:ClassicPlusModManager/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusOptionsVM}">
                <skins:ClassicPlusOptions/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusLogVM}">
                <skins:ClassicPlusLog/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type logic:ClassicPlusOtherVM}">
                <skins:ClassicPlusOther/>
            </DataTemplate>

            <!-- Default fonts to be used across the application whenever a specific font is not specified -->
            <FontFamily x:Key="DefaultFont">Segoe UI, Liberation Sans, Arial, sans-serif</FontFamily>
            <FontFamily x:Key="SemiLightWithFallback">Segoe UI Semilight, Segoe UI, Liberation Sans, Arial, sans-serif</FontFamily>
            <!-- TODO: can put other font types like monospaced here, so that instead of only-Consolas, it has a fallback if needed -->
            
            <!-- Make controls default to my specified fonts, so they don't fall back to system fonts for e.g., Linux users -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
